{
  "name": "my-yt-japan-restaurant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Japan food Shorts map with source-neutral public display.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "ingest:youtube": "tsx scripts/ingest-youtube.ts",
    "extract:places": "tsx scripts/extract-place-candidates.ts",
    "geocode:places": "tsx scripts/geocode-place-candidates.ts",
    "build:data": "tsx scripts/build-public-places.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "data:doctor": "tsx scripts/data-doctor.ts",
    "data:dry-run": "tsx scripts/data-dry-run.ts",
    "data:all": "npm run ingest:youtube && npm run extract:places && npm run geocode:places && npm run build:data && npm run validate:data"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  }
}
